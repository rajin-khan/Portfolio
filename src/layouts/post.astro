---
import Layout from "./main.astro";

const { title, description, date, updated, image } = Astro.props;
const siteUrl = Astro.site || new URL("https://rajinkhan.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const publishedTime = new Date(date).toISOString();
const modifiedTime = new Date(updated || date).toISOString();
const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"@id": `${canonicalUrl.href}#article`,
	mainEntityOfPage: canonicalUrl.href,
	headline: title,
	description,
	image: image ? [new URL(image, siteUrl).href] : undefined,
	datePublished: publishedTime,
	dateModified: modifiedTime,
	author: {
		"@type": "Person",
		"@id": `${siteUrl.href}#person`,
		name: "Rajin Khan",
		url: new URL("/about/", siteUrl).href,
	},
	inLanguage: "en",
};
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Blog",
			item: new URL("/posts/", siteUrl).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: title,
			item: canonicalUrl.href,
		},
	],
};
---

<Layout
	title={title}
	description={description}
	ogImage={image}
	ogImageAlt={`Cover image for ${title}`}
	type="article"
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	structuredData={[articleSchema, breadcrumbSchema]}
>
	<div class="post-shell">
		<slot />
	</div>
</Layout>

<style>
	.post-shell {
		position: relative;
		z-index: 30;
		width: min(100%, 1120px);
		margin: 0 auto;
		padding: 40px 28px 72px;
		color: #f2f2ef;
	}

	@media (max-width: 640px) {
		.post-shell {
			padding: 28px 16px 56px;
		}
	}
</style>
