---
import type { ProjectDetailData } from "../../lib/projects";

interface Props {
	actions: ProjectDetailData["heroActions"];
}

const { actions } = Astro.props;

function isExternal(href: string) {
	return /^https?:\/\//i.test(href);
}

function isGitHub(href: string) {
	return /github\.com/i.test(href);
}
---

{
	actions.length > 0 && (
		<div class="project-actions">
			{actions.map((action) => {
				const external = isExternal(action.href);
				const github = isGitHub(action.href);
				return (
					<a
						href={action.href}
						class:list={[
							"project-action",
							action.primary ? "project-action--primary" : "project-action--secondary",
							{ "project-action--github": github },
						]}
						{...(external
							? { target: "_blank", rel: "noopener noreferrer" }
							: {})}
					>
						{github && (
							<svg
								class="project-action-github"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path
									fill-rule="evenodd"
									d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
									clip-rule="evenodd"
								/>
							</svg>
						)}
						<span class="project-action-label">{action.label}</span>
						{action.primary && (
							<span class="project-action-sheen" aria-hidden="true" />
						)}
					</a>
				);
			})}
		</div>
	)
}

<style>
	.project-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem 0.85rem;
		margin: 1.35rem 0 0;
	}

	.project-action {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			border-color 280ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 280ms cubic-bezier(0.22, 1, 0.36, 1),
			color 280ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 280ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-action-github {
		position: relative;
		z-index: 1;
		flex: 0 0 auto;
		width: 0.9rem;
		height: 0.9rem;
	}

	.project-action--primary {
		padding: 0.5rem 1.25rem;
		border: 1px solid
			color-mix(
				in srgb,
				var(--project-accent-primary, #404040) 40%,
				rgb(38 38 38)
			);
		border-radius: 999px;
		background: rgb(23 23 23);
		color: #fff;
		box-shadow: 0 0 0 transparent;
	}

	.project-action--primary:hover,
	.project-action--primary:focus-visible {
		border-color: color-mix(
			in srgb,
			var(--project-accent-primary, #737373) 55%,
			rgb(64 64 64)
		);
		background: rgb(38 38 38);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--project-accent-primary, transparent) 18%, transparent),
			0 0 22px color-mix(in srgb, var(--project-accent-primary, transparent) 16%, transparent);
		transform: scale(1.03);
	}

	.project-action--primary:active {
		transform: scale(0.97);
	}

	.project-action--primary:focus-visible {
		outline: 2px solid
			color-mix(in srgb, var(--project-accent-primary, #ffffff) 45%, transparent);
		outline-offset: 3px;
	}

	.project-action-label {
		position: relative;
		z-index: 1;
	}

	.project-action-sheen {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(to bottom, rgba(255, 255, 255, 0.05), transparent);
		opacity: 0;
		pointer-events: none;
		transition: opacity 280ms ease;
	}

	.project-action--primary:hover .project-action-sheen,
	.project-action--primary:focus-visible .project-action-sheen {
		opacity: 1;
	}

	.project-action--secondary {
		padding: 0.45rem 0.15rem;
		border: 0;
		background: transparent;
		color: #9a9a96;
	}

	.project-action--secondary:hover,
	.project-action--secondary:focus-visible {
		color: #f2f2ef;
	}

	.project-action--github.project-action--secondary:hover .project-action-github,
	.project-action--github.project-action--secondary:focus-visible .project-action-github {
		color: color-mix(
			in srgb,
			var(--project-accent-primary, #f2f2ef) 55%,
			#f2f2ef
		);
	}

	.project-action--secondary:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.35);
		outline-offset: 4px;
		border-radius: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-action {
			transition: none;
		}

		.project-action--primary:hover,
		.project-action--primary:focus-visible,
		.project-action--primary:active {
			transform: none;
		}
	}
</style>
