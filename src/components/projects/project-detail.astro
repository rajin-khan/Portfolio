---
import type { ProjectDetailData } from "../../lib/projects";
import type { RelatedProject } from "../../lib/related-projects";
import ProjectHero from "./hero.astro";
import ProjectSections from "./sections.astro";
import ProjectRelated from "./related.astro";

interface Props {
	project: ProjectDetailData;
	related: RelatedProject | null;
}

const { project, related } = Astro.props;
const projectStyle = `--project-accent-primary: ${project.accents.primary}; --project-accent-secondary: ${project.accents.secondary};`;
---

<article class="project-page" style={projectStyle}>
	<ProjectHero project={project} />
	<ProjectSections sections={project.sections} />
	<ProjectRelated project={related} />
</article>

<style>
	.project-page {
		--paper: #f2f2ef;
		--muted: #9a9a96;
		--line: rgba(255, 255, 255, 0.11);
		position: relative;
		z-index: 20;
		width: min(100%, 42rem);
		margin: 2.5rem auto 4.5rem;
		padding: 0 1.25rem;
		color: var(--paper);
	}

	@media (max-width: 640px) {
		.project-page {
			margin-top: 1.75rem;
			margin-bottom: 3.5rem;
			padding: 0 1rem;
		}
	}
</style>
