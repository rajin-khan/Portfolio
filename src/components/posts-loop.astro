---
import { getCollection } from "astro:content";
import Button from "./button.astro";

const { count = 3 } = Astro.props;

const allPosts = await getCollection("post");

const posts = allPosts
	.map((post) => {
		const date = new Date(post.data.date);
		return {
			slug: post.slug,
			title: post.data.title,
			description: post.data.description,
			image: post.data.image,
			dateLabel: date.toLocaleDateString("en-US", {
				year: "numeric",
				month: "short",
				day: "numeric",
			}),
			dateIso: date.toISOString(),
			timestamp: date.getTime(),
		};
	})
	.sort((a, b) => b.timestamp - a.timestamp)
	.slice(0, Number(count));
---

<div class="home-posts-wrap">
	<div class="home-posts">
		{
			posts.map((post) => (
				<a class="home-post" href={`/post/${post.slug}`}>
					<article class="home-post-inner">
						<div class="home-post-copy">
							<h3 class="home-post-title">{post.title}</h3>
							<p class="home-post-description">{post.description}</p>
							<time class="home-post-date" datetime={post.dateIso}>
								{post.dateLabel}
							</time>
						</div>

						{post.image && (
							<div class="home-post-thumb">
								<img
									src={post.image}
									alt=""
									loading="lazy"
									decoding="async"
									width="112"
									height="112"
								/>
							</div>
						)}
					</article>
				</a>
			))
		}
	</div>

	<div class="home-posts-all">
		<Button text="View All Posts" link="/posts" />
	</div>
</div>

<style>
	.home-posts-wrap {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		min-width: 0;
	}

	.home-posts {
		--paper: #f2f2ef;
		--muted: #9a9a96;
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
		overflow: visible;
		padding: 0.25rem 0.2rem;
		margin: -0.25rem -0.2rem;
	}

	.home-post {
		position: relative;
		display: block;
		isolation: isolate;
		color: inherit;
		text-decoration: none;
	}

	.home-post::before {
		position: absolute;
		inset: 0;
		z-index: 0;
		border: 1px dashed rgba(255, 255, 255, 0.17);
		border-radius: 10px;
		background: transparent;
		content: "";
		pointer-events: none;
		transition:
			border-color 160ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.home-post:hover::before,
	.home-post:focus-visible::before {
		border-color: rgba(255, 255, 255, 0.27);
		transform: translate3d(3px, 3px, 0);
	}

	.home-post:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.5);
		outline-offset: 4px;
	}

	.home-post-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 4.5rem;
		gap: 0.75rem;
		align-items: center;
		min-width: 0;
		margin: 0;
		padding: 0.75rem 0.8rem;
		border: 1px solid rgba(255, 255, 255, 0.085);
		border-radius: 10px;
		background: #0d0d0d;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.14);
		backface-visibility: hidden;
		transition:
			border-color 160ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.home-post:hover .home-post-inner,
	.home-post:focus-visible .home-post-inner {
		border-color: rgba(255, 255, 255, 0.15);
		transform: translate3d(-3px, -3px, 0);
	}

	.home-post-copy {
		min-width: 0;
	}

	.home-post-title {
		margin: 0;
		color: var(--paper);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.3;
		text-wrap: balance;
	}

	.home-post-description {
		display: -webkit-box;
		margin: 0.28rem 0 0;
		overflow: hidden;
		color: rgb(177 177 172);
		font-size: 0.78rem;
		font-weight: 400;
		line-height: 1.35;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
	}

	.home-post-date {
		display: block;
		margin: 0.45rem 0 0;
		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 500;
	}

	.home-post-thumb {
		position: relative;
		overflow: hidden;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 6px;
		background: rgb(255 255 255 / 0.03);
		isolation: isolate;
	}

	.home-post-thumb::after {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			transparent 55%,
			rgba(0, 0, 0, 0.16)
		);
		content: "";
		opacity: 0.45;
		pointer-events: none;
		transition: opacity 180ms ease;
	}

	.home-post-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.home-post:hover .home-post-thumb::after,
	.home-post:focus-visible .home-post-thumb::after {
		opacity: 0.18;
	}

	.home-post:hover .home-post-thumb img,
	.home-post:focus-visible .home-post-thumb img {
		transform: scale(1.04);
	}

	.home-posts-all {
		display: flex;
		justify-content: center;
		padding-top: 0.35rem;
	}

	.home-posts-all :global(a) {
		margin-top: 0.85rem;
	}

	@media (max-width: 420px) {
		.home-post-inner {
			grid-template-columns: minmax(0, 1fr) 3.85rem;
			gap: 0.65rem;
			padding: 0.7rem;
		}

		.home-post-thumb {
			width: 3.85rem;
			height: 3.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-post::before,
		.home-post-inner,
		.home-post-thumb img,
		.home-post-thumb::after {
			transition: none;
		}

		.home-post:hover::before,
		.home-post:focus-visible::before,
		.home-post:hover .home-post-inner,
		.home-post:focus-visible .home-post-inner,
		.home-post:hover .home-post-thumb img,
		.home-post:focus-visible .home-post-thumb img {
			transform: none;
		}
	}
</style>
