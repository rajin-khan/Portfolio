<script>
	function enhanceCodeBlocks() {
		const root = document.querySelector(".post-prose");
		if (!(root instanceof HTMLElement)) return;

		root.querySelectorAll("pre").forEach((pre) => {
			if (!(pre instanceof HTMLElement)) return;
			if (pre.parentElement?.classList.contains("post-code")) return;

			const wrap = document.createElement("div");
			wrap.className = "post-code";

			const caption = document.createElement("div");
			caption.className = "post-code-caption";
			caption.setAttribute("aria-live", "polite");

			const hint = document.createElement("span");
			hint.className = "post-code-hint";
			hint.textContent = "tap to copy";

			const status = document.createElement("span");
			status.className = "post-code-status";
			status.setAttribute("aria-hidden", "true");
			status.textContent = "copied!";

			caption.appendChild(hint);
			caption.appendChild(status);

			pre.replaceWith(wrap);
			wrap.appendChild(pre);
			wrap.appendChild(caption);

			pre.setAttribute("role", "button");
			pre.setAttribute("tabindex", "0");
			pre.setAttribute("aria-label", "Code block. Tap to copy.");

			let resetTimer = 0;

			const copy = async () => {
				const code = pre.querySelector("code");
				const text = (code?.textContent ?? pre.textContent ?? "").replace(/\n$/, "");
				if (!text) return;

				try {
					await navigator.clipboard.writeText(text);
				} catch {
					const range = document.createRange();
					range.selectNodeContents(code ?? pre);
					const selection = window.getSelection();
					selection?.removeAllRanges();
					selection?.addRange(range);
					document.execCommand("copy");
					selection?.removeAllRanges();
				}

				wrap.classList.remove("is-copied");
				// Retrigger enter animation on rapid re-taps.
				void wrap.offsetWidth;
				wrap.classList.add("is-copied");
				status.removeAttribute("aria-hidden");
				hint.setAttribute("aria-hidden", "true");

				window.clearTimeout(resetTimer);
				resetTimer = window.setTimeout(() => {
					wrap.classList.remove("is-copied");
					status.setAttribute("aria-hidden", "true");
					hint.removeAttribute("aria-hidden");
				}, 1750);
			};

			pre.addEventListener("click", () => {
				const selection = window.getSelection();
				if (selection && !selection.isCollapsed && pre.contains(selection.anchorNode)) {
					return;
				}
				void copy();
			});

			pre.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					void copy();
				}
			});
		});
	}

	enhanceCodeBlocks();
	document.addEventListener("astro:page-load", enhanceCodeBlocks);
</script>

<style is:global>
	.post-prose .post-code {
		--paper: #f2f2ef;
		--muted: #8a8a86;
		margin-top: 1.65rem;
		margin-bottom: 1.85rem;
	}

	.post-prose .post-code > pre {
		margin-top: 0;
		margin-bottom: 0;
		cursor: pointer;
		transition:
			border-color 280ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.post-prose .post-code > pre:hover {
		border-color: rgba(255, 255, 255, 0.16);
	}

	.post-prose .post-code > pre:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.35);
		outline-offset: 3px;
		border-color: rgba(255, 255, 255, 0.2);
	}

	.post-prose .post-code.is-copied > pre {
		border-color: rgba(242, 242, 239, 0.28);
		box-shadow:
			0 0 0 1px rgba(242, 242, 239, 0.05),
			0 10px 28px rgba(0, 0, 0, 0.22);
		animation: post-code-press 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.post-prose .post-code-caption {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 1.55rem;
		margin-top: 0.55rem;
		user-select: none;
		pointer-events: none;
	}

	.post-prose .post-code-hint,
	.post-prose .post-code-status {
		grid-area: 1 / 1;
		margin: 0;
		line-height: 1.2;
		text-align: center;
		transition:
			opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
			filter 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.post-prose .post-code-hint {
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		opacity: 0.85;
		transform: translateY(0) scale(1);
		filter: blur(0);
	}

	.post-prose .post-code-status {
		color: var(--paper);
		font-family: "La Belle Aurore", "Bradley Hand", "Segoe Print", cursive;
		font-size: 1.2rem;
		font-weight: 400;
		letter-spacing: 0.01em;
		opacity: 0;
		transform: translateY(0.35rem) scale(0.96) rotate(-2deg);
		filter: blur(3px);
		transform-origin: center;
	}

	.post-prose .post-code.is-copied .post-code-hint {
		opacity: 0;
		transform: translateY(-0.35rem) scale(0.98);
		filter: blur(2px);
	}

	.post-prose .post-code.is-copied .post-code-status {
		opacity: 1;
		transform: translateY(0) scale(1) rotate(-1.5deg);
		filter: blur(0);
		animation: post-code-copied-in 560ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	@keyframes post-code-press {
		0% {
			transform: scale(1);
		}
		35% {
			transform: scale(0.992);
		}
		100% {
			transform: scale(1);
		}
	}

	@keyframes post-code-copied-in {
		0% {
			opacity: 0;
			transform: translateY(0.4rem) scale(0.94) rotate(-3deg);
			filter: blur(4px);
		}
		55% {
			opacity: 1;
			transform: translateY(-0.08rem) scale(1.02) rotate(-1deg);
			filter: blur(0);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1) rotate(-1.5deg);
			filter: blur(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-prose .post-code > pre,
		.post-prose .post-code-hint,
		.post-prose .post-code-status {
			transition: none;
		}

		.post-prose .post-code.is-copied > pre,
		.post-prose .post-code.is-copied .post-code-status {
			animation: none;
		}

		.post-prose .post-code-hint,
		.post-prose .post-code-status {
			filter: none;
			transform: none;
		}

		.post-prose .post-code.is-copied .post-code-hint {
			opacity: 0;
		}

		.post-prose .post-code.is-copied .post-code-status {
			opacity: 1;
		}
	}
</style>
