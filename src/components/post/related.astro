---
import type { RelatedPost } from "../../lib/related-posts";
import Button from "../button.astro";

interface Props {
	posts: RelatedPost[];
}

const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<section class="post-related" aria-labelledby="post-related-heading">
			<div class="post-related-titles">
				<h2 class="post-related-heading" id="post-related-heading">
					Read another
				</h2>
				<p class="post-related-aside">(only if you want to, no pressure)</p>
			</div>

			<ul class="post-related-list">
				{posts.map((post) => (
					<li>
						<a class="post-related-card" href={`/post/${post.slug}`}>
							<article class="post-related-inner">
								<div class="post-related-copy">
									<time datetime={post.dateIso}>{post.dateLabel}</time>
									<h3>{post.title}</h3>
									<p>{post.description}</p>
									{post.tags.length > 0 && (
										<div class="post-related-tags" aria-label={`${post.title} tags`}>
											{post.tags.slice(0, 3).map((tag) => (
												<span>{tag}</span>
											))}
										</div>
									)}
								</div>
								{post.image && (
									<div class="post-related-thumb">
										<img
											src={post.image}
											alt=""
											loading="lazy"
											decoding="async"
											width="128"
											height="80"
										/>
									</div>
								)}
							</article>
						</a>
					</li>
				))}
			</ul>

			<div class="post-related-back">
				<Button text="Back to Blog" link="/posts" />
			</div>
		</section>
	)
}

<style>
	.post-related {
		--paper: #f2f2ef;
		--muted: #9a9a96;
		max-width: 42rem;
		margin: 3.5rem auto 0;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--paper);
		text-align: center;
	}

	.post-related-titles {
		margin: 0 0 1.35rem;
	}

	.post-related-heading {
		margin: 0;
		color: var(--paper);
		font-size: clamp(1.25rem, 3vw, 1.55rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}

	.post-related-aside {
		margin: 0.45rem 0 0;
		color: var(--paper);
		font-family: "La Belle Aurore", "Bradley Hand", "Segoe Print", cursive;
		font-size: 1.05rem;
		font-weight: 400;
		line-height: 1.3;
		opacity: 0.9;
		transform: rotate(-1deg);
		transform-origin: center;
	}

	.post-related-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin: 0;
		padding: 0;
		list-style: none;
		text-align: left;
	}

	.post-related-card {
		position: relative;
		display: block;
		isolation: isolate;
		color: inherit;
		text-decoration: none;
	}

	.post-related-card::before {
		position: absolute;
		inset: 0;
		z-index: 0;
		border: 1px dashed rgba(255, 255, 255, 0.17);
		border-radius: 10px;
		background: transparent;
		content: "";
		pointer-events: none;
		transition:
			border-color 160ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.post-related-card:hover::before,
	.post-related-card:focus-visible::before {
		border-color: rgba(255, 255, 255, 0.27);
		transform: translate3d(3px, 3px, 0);
	}

	.post-related-card:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.5);
		outline-offset: 4px;
	}

	.post-related-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 5.5rem;
		gap: 0.9rem;
		align-items: center;
		min-width: 0;
		margin: 0;
		padding: 0.95rem;
		border: 1px solid rgba(255, 255, 255, 0.085);
		border-radius: 10px;
		background: #0d0d0d;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.14);
		backface-visibility: hidden;
		transition:
			border-color 160ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.post-related-card:hover .post-related-inner,
	.post-related-card:focus-visible .post-related-inner {
		border-color: rgba(255, 255, 255, 0.15);
		transform: translate3d(-3px, -3px, 0);
	}

	.post-related-copy {
		min-width: 0;
	}

	.post-related-copy time {
		display: block;
		margin: 0 0 0.28rem;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 500;
	}

	.post-related-copy h3 {
		margin: 0;
		color: var(--paper);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.3;
		text-wrap: balance;
	}

	.post-related-copy p {
		display: -webkit-box;
		margin: 0.35rem 0 0;
		overflow: hidden;
		color: rgb(177 177 172);
		font-size: 0.82rem;
		line-height: 1.4;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	.post-related-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 0;
		margin-top: 0.65rem;
	}

	.post-related-tags > span {
		display: inline-flex;
		align-items: center;
		color: #858581;
		font-size: 0.57rem;
		font-weight: 600;
		line-height: 1;
	}

	.post-related-tags > span:not(:last-child)::after {
		margin-inline: 7px;
		color: #50504d;
		content: "/";
		font-weight: 500;
	}

	.post-related-thumb {
		overflow: hidden;
		width: 5.5rem;
		height: 3.5rem;
		border-radius: 6px;
		background: rgb(255 255 255 / 0.03);
	}

	.post-related-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.post-related-card:hover .post-related-thumb img,
	.post-related-card:focus-visible .post-related-thumb img {
		transform: scale(1.04);
	}

	.post-related-back {
		margin-top: 0.5rem;
	}

	@media (max-width: 520px) {
		.post-related-inner {
			grid-template-columns: minmax(0, 1fr) 4.5rem;
			gap: 0.7rem;
			padding: 0.85rem;
		}

		.post-related-thumb {
			width: 4.5rem;
			height: 4.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-related-card::before,
		.post-related-inner,
		.post-related-thumb img {
			transition: none;
		}

		.post-related-card:hover::before,
		.post-related-card:focus-visible::before,
		.post-related-card:hover .post-related-inner,
		.post-related-card:focus-visible .post-related-inner,
		.post-related-card:hover .post-related-thumb img,
		.post-related-card:focus-visible .post-related-thumb img {
			transform: none;
		}
	}
</style>
