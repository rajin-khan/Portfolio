---
import Button from "../components/button.astro";
import ChatButton from "../components/chatbutton.astro";
import Projects from "../components/home/projects.astro";
import Separator from "../components/home/separator.astro";
import Writings from "../components/home/writings.astro";
import Layout from "../layouts/main.astro";
import StatusIndicator from "../components/status-indicator.astro";
import TechStack from "../components/tech-stack.astro";
import LatestCommit from "../components/latest-commit.astro";
import Newsletter from "../components/home/newsletter.astro";
import StickerBoard from "../components/sticker-board.jsx";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://rajinkhan.com/#person",
  name: "Rajin Khan",
  alternateName: "Adib Ar Rahman Khan",
  description:
    "AI engineer, developer, and Computer Science student in Dhaka building thoughtful products across generative AI, computer vision, and the web.",
  url: "https://rajinkhan.com/",
  sameAs: [
    "https://github.com/rajin-khan",
    "https://www.linkedin.com/in/rajin-khan",
    "https://www.instagram.com/raaajiin/",
    "https://www.facebook.com/rajinisdown/",
  ],
  jobTitle: "AI Engineer",
  image: "https://rajinkhan.com/assets/images/rajin-darkbg-tiny.png",
  knowsAbout: [
    "Generative AI",
    "Deep Learning",
    "Machine Learning",
    "Computer Vision",
    "Full-Stack Web Development",
    "UI Design",
  ],
  worksFor: {
    "@type": "Organization",
    name: "Skelementor",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Dhaka",
    addressCountry: "Bangladesh",
  },
  alumniOf: {
    "@type": "School",
    name: "Sunnydale",
  },
  mainEntityOfPage: "https://rajinkhan.com/about/",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://rajinkhan.com/#website",
  name: "Rajin Khan",
  alternateName: ["rajin", "Rajin Khan Portfolio"],
  url: "https://rajinkhan.com/",
  inLanguage: "en",
  publisher: { "@id": "https://rajinkhan.com/#person" },
};

const pageTitle = "Rajin Khan | AI Engineer, Developer & Designer";
const pageDescription =
  "Portfolio and writing by Rajin Khan, an AI engineer and developer in Dhaka building thoughtful products across AI, computer vision, and the web.";
const ogImage = "/assets/images/rajins-banner-new.png";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  ogImageAlt="Rajin Khan, AI engineer, developer, and designer"
  structuredData={[websiteSchema, personSchema]}
>
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <!-- Animation applied to the entire hero section -->
    <section
      class="flex flex-col-reverse md:flex-row items-center animate-in"
      style="--animation-delay: 0ms;"
    >
      <div class="relative w-full md:w-1/2">
        <h1
          class="hero-title mb-5 text-4xl font-semibold leading-tight md:text-4xl lg:text-6xl dark:text-white"
        >
          <span class="hero-title-lead">Hey, I'm</span>{" "}
          <span class="hero-signature">
            <span class="hero-signature-name">Rajin</span>
            <svg viewBox="0 0 160 20" role="presentation" aria-hidden="true">
              <path pathLength="1" d="M8 13C42 7.5 88 5.2 154 10.5" />
            </svg>
          </span><span class="hero-signature-dot">.</span>
        </h1>
        <p class="hero-handwritten mb-6 text-[1.375rem] leading-relaxed text-neutral-700 dark:text-neutral-300">
          I make machines think so I don't have to. <br
            class="hidden lg:block"
          />
        </p>
        <h2 class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200">
          Obsessions:
        </h2>
        <ul
          class="py-2 space-y-[3px] text-sm list-disc list-inside text-neutral-500 dark:text-neutral-400"
        >
          <li>Generative AI</li>
          <li>Web Development</li>
          <li>Computer Vision</li>
          <li>UI Design and Interactions</li>
        </ul>
        <br/>
        <p class="hero-handwritten mb-4 text-base text-neutral-600 dark:text-neutral-400">
            P.S: If it's more than 5 words, please talk to my AI assistant.
        </p>
        <div class="flex items-center gap-4 flex-wrap">
          <ChatButton />
          <Button text="📝 Resume" link="/ARKResume2026.pdf" />
          <div>
            <StatusIndicator status="online" />  <!-- available statuses: online, offline, away, uni -->
          </div>
        </div>
      </div>

      <div
        class="relative flex justify-center w-full mt-10 md:mt-0 md:w-1/2 md:translate-y-4 xl:translate-y-0 order-first md:order-none"
      >
        <div
          class="relative flex items-center justify-center w-[280px] h-[280px] lg:w-[360px] lg:h-[360px] border-2 border-dashed rounded-full border-neutral-300 dark:border-neutral-700"
        >
          <img
            src="/assets/images/rajin-darkbg-tiny.png"
            class="w-[265px] h-[265px] lg:w-[335px] lg:h-[335px] rounded-full object-cover"
            alt="Rajin Khan - Senior Computer Science Student and AI Engineer"
            width="390"
            height="390"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>
  </div>

  <!-- Newsletter Section -->
  <Separator text="newsletter" />
  <div class="animate-in defer-render" style="--animation-delay: 150ms;">
    <Newsletter />
  </div>

  <!-- Animation applied to the separator -->
  <div class="animate-in" style="--animation-delay: 200ms;">
    <Separator text="My projects" />
  </div>

  <!-- Animation applied to the Projects section -->
  <div class="animate-in defer-render" style="--animation-delay: 400ms;">
    <Projects />
  </div>

  <Separator text="Tech Stack" />
  <div class="defer-render"><TechStack /></div>

  <Separator text="Latest Activity" />
  <!-- Octocat sits on the card rim and must paint above the panel. -->
  <div><LatestCommit /></div>

  <Separator text="Oh, and I talk a lot" />
  <!-- Hover glow / stack layers must paint outside the card bounds. -->
  <div><Writings /></div>

  <Separator text="Guest Book" />
  <!-- A fixed modal cannot live inside content-visibility containment. -->
  <StickerBoard client:visible={{ rootMargin: "500px" }} />
</Layout>

<style>
  @font-face {
    font-family: "La Belle Aurore";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/assets/fonts/la-belle-aurore-latin.woff2") format("woff2");
  }

  .hero-handwritten {
    font-family: "La Belle Aurore", "Bradley Hand", "Segoe Print", cursive;
    font-weight: 400;
  }

  .hero-title {
    --signature-start: 120ms;
    --signature-name-duration: 520ms;
    --signature-line-duration: 160ms;
    --signature-dot-delay: calc(
      var(--signature-start) + var(--signature-name-duration) + var(--signature-line-duration) +
        40ms
    );
    overflow: visible;
  }

  .hero-title-lead {
    font-size: 0.96em;
  }

  .hero-signature {
    position: relative;
    display: inline-block;
    overflow: visible;
    margin: 0 0.02em;
    padding: 0.28em 0.12em 0.08em;
    color: inherit;
    font-family: "La Belle Aurore", "Bradley Hand", "Segoe Print", cursive;
    font-size: 0.96em;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    vertical-align: baseline;
    transform: rotate(-2deg);
    transform-origin: left bottom;
  }

  .hero-signature-name {
    display: inline-block;
    padding: 0.1em 0.04em 0.35em;
    /* Start fully open so the j descender is visible while painting. */
    clip-path: inset(-0.15em -0.08em -0.4em -0.08em);
    -webkit-mask-image: linear-gradient(90deg, #000 0 50%, transparent 50% 100%);
    mask-image: linear-gradient(90deg, #000 0 50%, transparent 50% 100%);
    -webkit-mask-position: 100% 0;
    mask-position: 100% 0;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 200% 100%;
    mask-size: 200% 100%;
    animation:
      hero-signature-paint var(--signature-name-duration) linear var(--signature-start) forwards,
      hero-signature-trim var(--signature-line-duration) cubic-bezier(0.16, 1, 0.3, 1)
        calc(var(--signature-start) + var(--signature-name-duration)) forwards;
    will-change: mask-position, clip-path;
  }

  .hero-signature svg {
    position: absolute;
    left: -2%;
    /* Sit through the j descender so the stroke creates the clip. */
    bottom: 0.2em;
    width: 112%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .hero-signature path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
    animation: hero-signature-draw var(--signature-line-duration)
      cubic-bezier(0.16, 1, 0.3, 1)
      calc(var(--signature-start) + var(--signature-name-duration)) forwards;
  }

  .hero-signature-dot {
    display: inline-block;
    font-size: 0.78em;
    opacity: 0;
    animation: hero-signature-dot-in 280ms ease var(--signature-dot-delay) forwards;
  }

  @keyframes hero-signature-paint {
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  /* Trim the descender only as the underline strokes across. */
  @keyframes hero-signature-trim {
    from {
      clip-path: inset(-0.15em -0.08em -0.4em -0.08em);
    }
    to {
      clip-path: inset(-0.15em -0.08em 0.22em -0.08em);
    }
  }

  @keyframes hero-signature-draw {
    0% {
      opacity: 0;
      stroke-dashoffset: 1;
    }
    2% {
      opacity: 1;
      stroke-dashoffset: 0.98;
    }
    to {
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-signature-dot-in {
    from {
      opacity: 0;
      transform: translateY(0.08em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-signature-name {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
      clip-path: inset(-0.15em -0.08em 0.22em -0.08em);
      animation: none;
    }

    .hero-signature path {
      opacity: 1;
      stroke-dashoffset: 0;
      animation: none;
    }

    .hero-signature-dot {
      opacity: 1;
      animation: none;
    }
  }
</style>
