---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/main.astro";
import ProjectDetail from "../../components/projects/project-detail.astro";
import {
	getProjects,
	isProjectDetail,
	type ProjectDetailData,
} from "../../lib/projects";
import { getRelatedProject } from "../../lib/related-projects";

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	const detailProjects = projects
		.map((entry) => entry.data)
		.filter(isProjectDetail);

	return detailProjects.map((project) => ({
		params: { slug: project.slug },
		props: {
			project,
			related: getRelatedProject(project, detailProjects),
		},
	}));
}) satisfies GetStaticPaths;

interface Props {
	project: ProjectDetailData;
	related: ReturnType<typeof getRelatedProject>;
}

const { project, related } = Astro.props;
---

<Layout
	title={project.name}
	description={project.description}
	ogImage={project.image.src}
	ogImageAlt={`${project.name} project preview`}
>
	<ProjectDetail project={project} related={related} />
</Layout>
