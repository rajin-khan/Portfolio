---
import { getCollection, type CollectionEntry } from "astro:content";
import PostLayout from "../../layouts/post.astro";
import PostHero from "../../components/post/hero.astro";
import PostRelated from "../../components/post/related.astro";
import PostComments from "../../components/post/comments.astro";
import CodeCopy from "../../components/post/code-copy.astro";
import PostVideos from "../../components/post/videos.astro";
import Button from "../../components/button.astro";
import {
	estimateReadingMinutes,
	formatReadingTime,
} from "../../lib/reading-time";
import { getRelatedPosts } from "../../lib/related-posts";

export async function getStaticPaths() {
	const posts = await getCollection("post");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { entry: post },
	}));
}

type Props = {
	entry: CollectionEntry<"post">;
};

const { entry } = Astro.props;
const allPosts = await getCollection("post");

const { Content } = await entry.render();
const { title, description, date, updated, image, tags = [] } = entry.data;
const readingLabel = formatReadingTime(estimateReadingMinutes(entry.body));
const related = getRelatedPosts(entry, allPosts, 1);
---

<PostLayout
	title={title}
	description={description}
	date={date}
	updated={updated}
	image={image}
>
	<article class="post-page">
		<PostHero
			title={title}
			description={description}
			date={date}
			tags={tags}
			readingLabel={readingLabel}
		/>

		<div class="post-layout">
			<div class="post-main">
				<div class="post-prose prose dark:prose-invert">
					<Content />
				</div>
			</div>
		</div>

		<CodeCopy />
		<PostVideos />
		<PostRelated posts={related} />
		{
			related.length === 0 && (
				<div class="post-back-wrap">
					<Button text="Back to Blog" link="/posts" />
				</div>
			)
		}
		<PostComments />
	</article>
</PostLayout>

<style is:global>
	.post-page {
		--post-paper: #f2f2ef;
		--post-muted: #9a9a96;
		--post-faint: #6e6e6a;
		--post-line: rgba(255, 255, 255, 0.11);
	}

	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, 42rem);
		justify-content: center;
		margin-top: 0.5rem;
	}

	.post-main {
		min-width: 0;
		max-width: 42rem;
		width: 100%;
	}

	.post-prose.prose {
		max-width: none;
		color: rgb(196 196 190);
		font-size: 1.02rem;
		line-height: 1.75;
	}

	.post-prose.prose :where(h2, h3, h4) {
		color: var(--post-paper);
		font-weight: 600;
		letter-spacing: -0.02em;
		scroll-margin-top: 6rem;
	}

	.post-prose.prose :where(h2) {
		margin-top: 2.4rem;
		margin-bottom: 0.85rem;
		font-size: 1.55rem;
		line-height: 1.25;
	}

	.post-prose.prose :where(h3) {
		margin-top: 1.85rem;
		margin-bottom: 0.65rem;
		font-size: 1.2rem;
		line-height: 1.3;
	}

	.post-prose.prose :where(p, li) {
		color: rgb(196 196 190);
	}

	.post-prose.prose :where(a) {
		color: var(--post-paper);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.post-prose.prose :where(a:hover) {
		opacity: 0.85;
	}

	.post-prose.prose :where(strong) {
		color: var(--post-paper);
		font-weight: 600;
	}

	.post-prose.prose :where(blockquote) {
		border-left: 2px solid rgba(255, 255, 255, 0.22);
		color: #b7b7b1;
		font-style: normal;
	}

	.post-prose.prose :where(code) {
		color: #e8e8e2;
		font-weight: 500;
	}

	.post-prose.prose :where(pre),
	.post-prose.prose :where(pre.astro-code) {
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 12px;
		background: #050505 !important;
		background-color: #050505 !important;
	}

	.post-prose.prose :where(hr) {
		border-color: rgba(255, 255, 255, 0.1);
	}

	.post-prose.prose :where(img) {
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
	}

	.post-prose.prose :where(ul > li::marker, ol > li::marker) {
		color: #7a7a76;
	}

	@media (prefers-reduced-motion: reduce) {
		.post-page .animate-in {
			animation: none;
			opacity: 1;
		}
	}

	.post-back-wrap {
		max-width: 42rem;
		margin: 2.5rem auto 0;
		text-align: center;
	}
</style>
